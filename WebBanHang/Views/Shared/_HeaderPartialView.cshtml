<script>
	$(document).ready(function () {
		$.ajax({
			url: '@Url.Action("GetCartItemCount", "ShoppingCart")',
			type: 'GET',
			success: function (data) {
				$('#cart-count').text(data.count);
			},
			error: function () {
				console.error("Failed to load cart item count.");
			}
		});
	});
</script>