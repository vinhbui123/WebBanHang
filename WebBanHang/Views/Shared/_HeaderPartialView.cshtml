@{
    ViewData["Title"] = "Home";
}
<div id="header">
    <div class="container" style="width:1500px">
        <div id="welcomeLine" class="row">
            <div class="span6">Welcome! <strong>User</strong></div>
            <div class="span6" style="margin-left:20px">
                <div class="pull-right">
					@if (User.Identity.IsAuthenticated)
					{
					@await Component.InvokeAsync("NumberCart")
					}
                </div>
            </div>
        </div>
        <div id="logoArea" class="navbar">
            <a id="smallScreen" data-target="#topMenu" data-toggle="collapse" class="btn btn-navbar">
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </a>

            <div class="navbar-inner">
                <a class="brand" href="/Home/Index">
                    <img src="~/themes/images/logo.png" alt="Bootsshop" />
                </a>

                <form method="post" action="/findProduct" class="form-inline navbar-search" id="searchBy">
					<input id="srchFld" class="srchTxt form-control" name="searchQuery" type="text" placeholder="Enter item name" />
                    <button type="submit" class="btn-large" id="search-btn">Search</button>
                </form>

                <ul id="topMenu" class="nav pull-right">
                    <li><a href="special_offer.html">Special Offer</a></li>
                    <li><a href="normal.html">Delivery</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                </ul>

                <div class="dropdown">
                    <a class="dropbtn"><img src="/image/account.png" alt="Alternate Text" /></a>
                    <div class="dropdown-content">
						@if (User.Identity.IsAuthenticated)
						{
							<form method="post" action="@Url.Action("Logout", "Account")">
								<button type="submit" class="btn-large">Log out</button>
							</form>

							<!-- Button to redirect to Profile page -->
							<form action="@Url.Action("Profile", "Account")" style="margin-top:-20px">
								<button type="submit" class="btn-large">Profile</button>
							</form>
						}

                        else
                        {
                            <a href="@Url.Action("Login", "Account")" class="btn-large">Login</a>
                            <a href="@Url.Action("Signup", "Account")" class="btn-large">Sign Up</a>
                        }

                        </div>
                </div>
            </div>
        </div>
    </div>

