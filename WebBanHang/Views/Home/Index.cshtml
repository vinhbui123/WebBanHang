@{
    ViewData["Title"] = "Product";
}
@model X.PagedList.IPagedList<Product>
@using X.PagedList.Mvc.Core;

<div id="mainBody">
    <div class="container">
        <div class="row">
            <h3 style="display: flex; width: fit-content;margin-left:1000px;margin-bottom:60px">Products</h3>
            <ul class="thumbnails" style="width:1200px; margin-top:-40px">
                @foreach (var item in Model)
                {
                    var base64Image = item.Thumb != null ? "data:image/jpeg;base64," + Convert.ToBase64String(item.Thumb) : "~/themes/images/products/default.jpg";
                    <li class="span3">
                        <div class="thumbnail">
                            <a href="product_details.html">
                                <img src="@base64Image" alt="@item.ProductName" />
                            </a>
                            <div class="caption">
                                <h5>@item.ProductName</h5>
                                <h4 style="text-align:center">
                                    <a class="btn add-to-cart" data-productid="@item.ProductId">Add to <i class="icon-shopping-cart"></i></a>
                                    <a class="btn btn-primary" href="#">
                                        @((item.PriceDiscounts.HasValue ? item.PriceDiscounts.Value : item.Price).ToString("C"))
                                    </a>
                                </h4>
                            </div>
                        </div>
                    </li>
                }
            </ul>

            <div class="pagination">
                @Html.PagedListPager(
                         Model,
                         page => Url.Action("Index", new { page = page }),
                         new PagedListRenderOptions
                {
                    MaximumPageNumbersToDisplay = 5,
                    DisplayLinkToIndividualPages = true,
                    DisplayEllipsesWhenNotShowingAllPageNumbers = true,
                    EllipsesFormat = "..."
                })
            </div>
        </div>
    </div>
</div>
@section Scripts
{
    <script>
        $(document).ready(function () {
            // Handle click event on Add to Cart button
            $(".add-to-cart").click(function (e) {
                e.preventDefault();  // Prevent default link behavior

                var productId = $(this).data("productid");  // Get the productId from data attribute
                var amount = 1;  // You can modify this if needed, for example, based on a quantity input field

                $.ajax({
                    url: '@Url.Action("AddToCart", "ShoppingCart")',  // Use your controller action URL
                    type: 'POST',
                    data: {
                        productId: productId,
                        amount: amount
                    },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload(); // Display success message
                        } else {
                            alert(response.message);  // Display error message
                        }
                    },
                    error: function (xhr, status, error) {
                        alert("An error occurred: " + error);
                    }
                });
            });
        });

        //reload khi quay lai trang chinh
        window.addEventListener("pageshow", function (event) {
            var historyTraversal = event.persisted ||
                (typeof window.performance != "undefined" &&
                    window.performance.navigation.type === 2);
            if (historyTraversal) {
                // Handle page restore.
                window.location.reload();
            }
        });
    </script>
}
