@model List<WebBanHang.ModelViews.CartItem>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Adding hover and active states for a more interactive button -->
<style>
    button:hover {
        background-color: #444;
        transform: scale(1.05);
    }

    button:active {
        background-color: #333;
        transform: scale(1);
    }
</style>

<h2>Your Shopping Cart</h2>
 @if (Model != null && Model.Count() > 0){
<h4>Total money: @Model.Sum(x => x.TotalPrice).ToString("#,##0") $</h4>
<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.product.ProductName</td>
                <td>@(item.product.PriceDiscounts.HasValue ? item.product.PriceDiscounts.Value.ToString("C") : item.product.Price)<td>
                <td>@item.amount</td>
                <td>@(item.TotalPrice.ToString("C"))</td>
                <td>
                    <button class="btn btn-success btn-sm" onclick="updateCart(@item.product.ProductId, @item.amount + 1)">+</button>
                    <button class="btn btn-warning btn-sm" onclick="updateCart(@item.product.ProductId, @item.amount - 1)">-</button>
                        <button class="btn btn-danger btn-sm"
                                onclick="removeFromCart(@item.product.ProductId)">
                            Remove
                        </button>
                </td>
            </tr>
        }
    </tbody>
</table>
    <button onclick="window.location.href='@Url.Action("Payment", "Order")';" style="background-color: black; color: azure; padding: 10px 20px; border: none; border-radius: 5px; font-size: 16px; font-weight: bold; text-transform: uppercase; cursor: pointer; transition: background-color 0.3s ease, transform 0.2s ease;margin-left:20px">
        Thanh Toán
    </button>

 }
else
{
    <h4>Khong co san pham trong gio hang</h4>
}
<script>
    function updateCart(productId, amount) {
        $.ajax({
            url: '/ShoppingCart/UpdateCart',
            type: 'POST',
            data: { productId: productId, amount: amount },
            success: function (response) {
                if (response.success) {
                    alert(response.message);
                    location.reload(); // Reload the page to reflect changes
                } else {
                    alert(response.message);
                }
            },
            error: function () {
                alert('An error occurred while updating the cart.');
            }
        });
    }

    function removeFromCart(productId) {
        $.ajax({
            url: '@Url.Action("RemoveFromCart", "ShoppingCart")',
            type: 'POST',
            data: { productId: productId },
            success: function (response) {
                if (response.success) {
                    // Optionally, update the UI after successful removal (e.g., remove the item from the list)
                    alert(response.message);
                    location.reload();  // Or use AJAX to update the cart without reloading
                } else {
                    alert(response.message);  // Show error message if removal fails
                }
            },
            error: function (xhr, status, error) {
                alert('An error occurred: ' + error);
            }
        });
    }
</script>

