
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/admin/Views/Shared/_Admin_Layout.cshtml";
}


<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Tổng số sản phẩm</h5>
                <p class="card-text" id="totalProducts">...</p> 
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Tổng số người dùng</h5>
                <p class="card-text" id="totalUsers">...</p> 
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Tổng doanh thu</h5>
                <p class="card-text" id="totalRevenue">...</p> 
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Gọi API để lấy dữ liệu
            $.ajax({
                url: '@Url.Action("GetDashboardData", "Home")', // Thay đổi Home thành tên controller của bạn
                type: 'GET',
                success: function (data) {
                    // Cập nhật dữ liệu lên giao diện
                    $('#totalProducts').text(data.totalProducts);
                    $('#totalUsers').text(data.totalUsers);
                    $('#totalRevenue').text(data.totalRevenue.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' })); 
                }
            });
        });
    </script>

                }