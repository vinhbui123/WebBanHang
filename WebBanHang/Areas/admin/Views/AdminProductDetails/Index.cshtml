@model IEnumerable<WebBanHang.Model.ProductDetail>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/admin/Views/Shared/_Admin_Layout.cshtml";
}

<div class="container-fluid">
    <h1 class="mt-4">Danh sách chi tiết sản phẩm</h1>

    <p class="mt-3">
        <a asp-action="Create" class="btn btn-success"> <i class="fas fa-plus"></i> Thêm mới</a>
    </p>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Danh sách chi tiết
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Videos)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Color)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Brand)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Model)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.ModelYear)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Description)
                            </th>
                          
                            <th>
                                @Html.DisplayNameFor(model => model.Product)
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Videos)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Color)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Brand)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Model)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ModelYear)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Description)
                                </td>
                                
                                <td>
                                    @Html.DisplayFor(modelItem => item.Product.ProductId)
                                </td>
                                <td>
                                    <a class="btn btn-info btn-sm" asp-area="Admin" asp-controller="AdminProductDetails" asp-action="Details" asp-route-id="@item.ProductId">
                                        <i class="fas fa-eye"></i> Chi tiết
                                    </a>
                                    <a class="btn btn-primary btn-sm" asp-area="Admin" asp-controller="AdminProductDetails" asp-action="Edit" asp-route-id="@item.ProductId">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                    <a class="btn btn-danger btn-sm" asp-area="Admin" asp-controller="AdminProductDetails" asp-action="Delete" asp-route-id="@item.ProductId">
                                        <i class="fas fa-trash"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/js/all.min.js" crossorigin="anonymous"></script>