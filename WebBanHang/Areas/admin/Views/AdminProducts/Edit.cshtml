@model WebBanHang.Model.Product

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/admin/Views/Shared/_Admin_Layout.cshtml";
}

<h1>Edit</h1>

<h4>Product</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Hidden field for ProductId -->
            <input type="hidden" asp-for="ProductId" />

            <!-- Type dropdown -->
            <div class="form-group">
                <label asp-for="Type" class="control-label"></label>
                <select asp-for="Type" class="form-control" asp-items="ViewBag.DanhMuc"></select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>

            <!-- UnitInStock input -->
            <div class="form-group">
                <label asp-for="UnitInStock" class="control-label"></label>
                <input asp-for="UnitInStock" class="form-control" />
                <span asp-validation-for="UnitInStock" class="text-danger"></span>
            </div>

            <!-- Thumb input (File upload) -->
            <div class="form-group">
                <label asp-for="Thumb" class="control-label"></label>
                <input type="file" name="fThumb" class="form-control" />
                <span asp-validation-for="Thumb" class="text-danger"></span>
            </div>

            <!-- ProductName input -->
            <div class="form-group">
                <label asp-for="ProductName" class="control-label"></label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>

            <!-- SpecialStatus input -->
            <div class="form-group">
                <label asp-for="SpecialStatus" class="control-label"></label>
                <input asp-for="SpecialStatus" class="form-control" />
                <span asp-validation-for="SpecialStatus" class="text-danger"></span>
            </div>

            <!-- Price input -->
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <!-- PriceDiscounts input -->
            <div class="form-group">
                <label asp-for="PriceDiscounts" class="control-label"></label>
                <input asp-for="PriceDiscounts" class="form-control" />
                <span asp-validation-for="PriceDiscounts" class="text-danger"></span>
            </div>

            <!-- Submit button -->
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
