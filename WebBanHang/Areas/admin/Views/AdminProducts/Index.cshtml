@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<WebBanHang.Model.Product>

@{
    int CurrentPage = ViewBag.CurrentPage;
    ViewData["Title"] = "Danh sách sản phẩm " + CurrentPage;
    Layout = "~/Areas/admin/Views/Shared/_Admin_Layout.cshtml";
}

<div class="container-fluid">
    <h1 class="mt-4">Danh sách sản phẩm: Page @CurrentPage</h1>

    <div class="page-header d-flex justify-content-between mt-3">
        <div class="header-sub-title">
            <nav class="breadcrumb breadcrumb-dash">
                <a asp-controller="Home" asp-action="Index" asp-area="Admin" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Home</a>
                <span class="breadcrumb-item active">Danh sách sản phẩm</span>
            </nav>
        </div>
        <div class="text-right">
            <a class="btn btn-success" asp-area="Admin" asp-controller="AdminProducts" asp-action="Create">
                <i class="anticon anticon-plus-circle m-r-5"></i>
                <span>Thêm sản phẩm</span>
            </a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Danh sách sản phẩm
        </div>
        <div class="card-body">
            <div class="row m-b-30">
                <div class="col-lg-8">
                    <div class="d-md-flex">
                        <div class="m-b-10 m-r-15">
                            <select class="custom-select" id="txttypeID" name="txttypeID" style="min-width: 200px;" asp-items="ViewBag.DanhMuc">
                                <option selected>Chọn Loại Sản Phẩm</option>
                                <option value="all">Tất cả</option>
                            </select>
                        </div>
                        <div class="m-b-10 m-r-15">
                            <select class="custom-select" id="txtStatus" name="txtStatus" style="min-width: 150px;">
                                <option selected>Chọn Trạng Thái</option>
                                <option value="all">Tất cả</option>
                                <option value="instock">Còn hàng</option>
                                <option value="outofstock">Hết hàng</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th>ID</th>
                            <th>Tên sản phẩm</th>
                            <th>Loại sản phẩm</th>
                            <th>Giá</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ProductId</td>
                                    <td>@item.ProductName</td>
                                    <td>@item.Type</td>
                                    <td>@item.Price.ToString("#,##0") VNĐ</td>
                                    <td>
                                        @if (item.UnitInStock > 0)
                                        {
                                            <div class="d-flex align-items-center">
                                                <div class="badge badge-success badge-dot m-r-10"></div>
                                                <div>Còn hàng</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center">
                                                <div class="badge badge-danger badge-dot m-r-10"></div>
                                                <div>Hết hàng</div>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <a class="btn btn-info btn-sm" asp-area="Admin" asp-controller="AdminProducts" asp-action="Details" asp-route-id="@item.ProductId">
                                            <i class="fas fa-eye"></i> Chi tiết
                                        </a>
                                        <a class="btn btn-primary btn-sm" asp-area="Admin" asp-controller="AdminProducts" asp-action="Edit" asp-route-id="@item.ProductId">
                                            <i class="fas fa-edit"></i> Sửa
                                        </a>
                                        <a class="btn btn-danger btn-sm" asp-area="Admin" asp-controller="AdminProducts" asp-action="Delete" asp-route-id="@item.ProductId">
                                            <i class="fas fa-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <div aria-label="Page navigation example">
                    <ul class="pagination justify-content-center">
                        <pager class="pager-container" list="@Model" asp-area="Admin" asp-controller="AdminProducts" asp-action="Index" />
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/js/all.min.js" crossorigin="anonymous"></script>
@section Scripts {
    <script>
            $(document).ready(function () {
        $("#txttypeID, #txtStatus").change(function () {
            var typeName = $("#txttypeID").val();
            if (typeName === "all") {
                typeName = "";
            }
            var status = $("#txtStatus").val();
            if (status === "all") {
                status = "";
            }

            $.ajax({
                url: '/Admin/AdminProducts/Filter',
                type: "GET",
                data: {
                    Type: typeName,
                    Status: status
                },
                success: function (results) {
                    if (results.status === "success") {
                        window.location.href = results.redirectUrl;
                    }
                },
                error: function () {
                    alert('Lỗi khi lọc sản phẩm.');
                    }
                });
            });
        });
    </script>
}