@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<WebBanHang.Models.Customer>

@{
    int currentPage = ViewBag.CurrentPage;
    ViewData["Title"] = "Danh sách khách hàng " + currentPage;
    Layout = "~/Areas/admin/Views/Shared/_Admin_Layout.cshtml";
}

<div class="container-fluid">
    <h1 class="mt-4">Danh sách khách hàng: Page @currentPage</h1>

    <div class="page-header d-flex justify-content-between mt-3">
        <div class="header-sub-title">
            <nav class="breadcrumb breadcrumb-dash">
                <a asp-controller="Home" asp-action="Index" asp-area="Admin" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Home</a>
                <span class="breadcrumb-item active">Danh sách khách hàng</span>
            </nav>
        </div>
        <div class="text-right">
            <a class="btn btn-success" asp-area="Admin" asp-controller="AdminCustomers" asp-action="Create">
                <i class="fas fa-plus"></i> Thêm mới
            </a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Danh sách khách hàng
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th>ID</th>
                            <th>Họ và tên</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th>Địa chỉ</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.CustomerId</td>
                                    <td>@item.FullName</td>
                                    <td>@item.Phone</td>
                                    <td>@item.Email</td>
                                    <td>@item.Address</td>
                                    <td>
                                        <a class="btn btn-info btn-sm" asp-area="Admin" asp-controller="AdminCustomers" asp-action="Details" asp-route-id="@item.CustomerId">
                                            <i class="fas fa-eye"></i> Chi tiết
                                        </a>
                                        <a class="btn btn-primary btn-sm" asp-area="Admin" asp-controller="AdminCustomers" asp-action="Edit" asp-route-id="@item.CustomerId">
                                            <i class="fas fa-edit"></i> Sửa
                                        </a>
                                        <a class="btn btn-danger btn-sm" asp-area="Admin" asp-controller="AdminCustomers" asp-action="Delete" asp-route-id="@item.CustomerId">
                                            <i class="fas fa-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <div aria-label="Page navigation example">
                    <ul class="pagination justify-content-center">
                        <pager class="pager-container" list="@Model" asp-area="Admin" asp-controller="AdminCustomers" asp-action="Index" />
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/js/all.min.js" crossorigin="anonymous"></script>